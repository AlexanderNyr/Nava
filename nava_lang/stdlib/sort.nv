# Nava standard library: ordering over [i64].  Version 1.
#
# One sorting routine and the two questions around it.  Everything here works
# through the array borrow rules of edition 1: `[i64]` is read-only, `mut [i64]`
# may be written, and a sort is the reason the second form exists.

fn module_version() -> i64 {
    return 1
}

/// `is_sorted(values)` — is every element at least the one before it?
///
/// pre: none
/// post: the result is `true` exactly when no adjacent pair decreases
/// cost: O(n) for n elements, and O(1) for an empty or one-element array
/// pure: yes
/// example: let values: [i64] = [1, 2, 2, 3]; sort::is_sorted(values)
/// example: let empty: [i64] = []; sort::is_sorted(empty)
/// example: let backwards: [i64] = [2, 1]; !sort::is_sorted(backwards)
fn is_sorted(values: [i64]) -> bool {
    let index = 1
    while index < len(values) {
        if values[index] < values[index - 1] {
            return false
        }
        index = index + 1
    }
    return true
}

/// `insertion_sort(values)` — sort `values` in place, ascending.
///
/// pre: `values` is a writable array, so the call needs an array created here
/// post: the array is a permutation of what it held, `is_sorted` accepts it, and
/// equal elements keep their relative order
/// cost: O(n^2) comparisons and moves; the routine exists to give the language
/// one sort, not the fastest one
/// pure: no
/// example: let values: [i64] = [3, 1, 2]; sort::insertion_sort(values); values[0] == 1 && values[1] == 2 && values[2] == 3
/// example: let empty: [i64] = []; sort::insertion_sort(empty); len(empty) == 0
fn insertion_sort(values: mut [i64]) {
    let index = 1
    while index < len(values) {
        let key = values[index]
        let position = index - 1
        while position >= 0 && values[position] > key {
            values[position + 1] = values[position]
            position = position - 1
        }
        values[position + 1] = key
        index = index + 1
    }
}

/// `binary_search(values, wanted)` — where `wanted` sits in a sorted array.
///
/// pre: `is_sorted(values)` holds; searching an unsorted array is a caller error
/// and is not detected
/// post: the result is a valid index whose element equals `wanted`, or -1 when
/// `wanted` is absent
/// cost: O(log n) comparisons for n elements
/// pure: yes
/// example: let values: [i64] = [1, 2, 3]; sort::binary_search(values, 2) == 1
/// example: let values: [i64] = [1, 2, 3]; sort::binary_search(values, 9) == -1
/// example: let empty: [i64] = []; sort::binary_search(empty, 1) == -1
fn binary_search(values: [i64], wanted: i64) -> i64 {
    let low = 0
    let high = len(values) - 1
    while low <= high {
        let middle = low + (high - low) / 2
        if values[middle] == wanted {
            return middle
        }
        if values[middle] < wanted {
            low = middle + 1
        } else {
            high = middle - 1
        }
    }
    return -1
}
