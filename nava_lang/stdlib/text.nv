# Nava standard library: UTF-8 text.  Version 1.
#
# A `str` is a NUL-terminated UTF-8 byte sequence.  `bytes_len` (builtin) counts
# bytes, `chars_len` (builtin) counts code points and rejects invalid input;
# the functions here add validation and classification without allocating.

fn module_version() -> i64 {
    return 1
}

/// `is_continuation(byte)` — is this byte a UTF-8 continuation byte?
///
/// pre: `byte` is a byte value, 0..255 in practice
/// post: the result is `true` exactly for the range 128..191
/// cost: O(1)
/// pure: yes
/// example: text::is_continuation(128) && text::is_continuation(191)
/// example: !text::is_continuation(127) && !text::is_continuation(192)
fn is_continuation(byte: i64) -> bool {
    return byte >= 128 && byte <= 191
}

/// `sequence_width(value, index)` — the length in bytes of the UTF-8 sequence at
/// `index`, or 0 when it is malformed.
///
/// pre: `0 <= index < bytes_len(value)`; the caller checks the range, and the
/// byte read stops the program when it does not hold
/// post: the result is 1, 2, 3 or 4 for a well-formed sequence and 0 for a
/// malformed one — overlong forms, surrogates and anything above U+10FFFF are
/// malformed
/// cost: O(1)
/// pure: yes
/// example: text::sequence_width("a", 0) == 1 && text::sequence_width("\u00e9", 0) == 2
/// example: text::sequence_width("\u20ac", 0) == 3
/// error: text::sequence_width("abc", 7) => byte index 7 is out of bounds for a string of 3 bytes
fn sequence_width(value: str, index: i64) -> i64 {
    let length = bytes_len(value)
    let first = byte_at(value, index)
    if first < 128 {
        return 1
    }
    if first < 194 {
        # 0x80..0xC1: a stray continuation byte, or an overlong two-byte form.
        return 0
    }
    if first < 224 {
        if index + 1 >= length {
            return 0
        }
        if !is_continuation(byte_at(value, index + 1)) {
            return 0
        }
        return 2
    }
    if first < 240 {
        if index + 2 >= length {
            return 0
        }
        let second = byte_at(value, index + 1)
        if !is_continuation(second) || !is_continuation(byte_at(value, index + 2)) {
            return 0
        }
        if first == 224 && second < 160 {
            return 0
        }
        if first == 237 && second > 159 {
            return 0
        }
        return 3
    }
    if first < 245 {
        if index + 3 >= length {
            return 0
        }
        let second = byte_at(value, index + 1)
        if (!is_continuation(second) || !is_continuation(byte_at(value, index + 2))
            || !is_continuation(byte_at(value, index + 3))) {
            return 0
        }
        if first == 240 && second < 144 {
            return 0
        }
        if first == 244 && second > 143 {
            return 0
        }
        return 4
    }
    return 0
}

/// `is_valid_utf8(value)` — is the whole string well-formed UTF-8?
///
/// pre: none
/// post: the result is `true` exactly when every sequence in the string is
/// well-formed, so the builtin `chars_len` would accept it
/// cost: O(n) for n bytes
/// pure: yes
/// example: text::is_valid_utf8("hello") && text::is_valid_utf8("")
/// example: text::is_valid_utf8("\u00e9\u20ac")
fn is_valid_utf8(value: str) -> bool {
    let length = bytes_len(value)
    let index = 0
    while index < length {
        let width = sequence_width(value, index)
        if width == 0 {
            return false
        }
        index = index + width
    }
    return true
}

/// `code_points(value)` — how many code points the string holds.
///
/// pre: none
/// post: the result is the number of well-formed sequences, or -1 when the string
/// is not valid UTF-8; the builtin `chars_len` stops the program instead
/// cost: O(n) for n bytes
/// pure: yes
/// example: text::code_points("hello") == 5 && text::code_points("") == 0
/// example: text::code_points("\u00e9\u20ac") == 2
fn code_points(value: str) -> i64 {
    let length = bytes_len(value)
    let index = 0
    let count = 0
    while index < length {
        let width = sequence_width(value, index)
        if width == 0 {
            return -1
        }
        index = index + width
        count = count + 1
    }
    return count
}

/// `is_ascii(value)` — is every byte below 128?
///
/// pre: none
/// post: the result is `true` exactly when no byte of the string is 128 or above
/// cost: O(n) for n bytes
/// pure: yes
/// example: text::is_ascii("hello") && text::is_ascii("")
/// example: !text::is_ascii("\u00e9")
fn is_ascii(value: str) -> bool {
    let index = 0
    while index < bytes_len(value) {
        if byte_at(value, index) > 127 {
            return false
        }
        index = index + 1
    }
    return true
}
