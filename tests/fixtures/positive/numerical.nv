fn main() {
    print(7 / 3)
    print(-7 / 3)
    print(7 / -3)
    print(-7 / -3)
    print(7 % 3)
    print(-7 % 3)
    print(7 % -3)
    print(-7 % -3)
    print(9223372036854775807 - 1)
    print(-9223372036854775808 + 1)
    print(-9223372036854775808 / 1)
    print(-9223372036854775808 % 3)
    print(3037000499 * 2)
    print(-9223372036854775808 == -9223372036854775807 - 1)
    print(to_i64(-0.0) == 0)
    print(to_f64(9007199254740993) == 9007199254740992.0)
}
