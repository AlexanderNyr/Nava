fn fill(a: mut [i64], value: i64) {
    let i = 0
    while i < len(a) {
        a[i] = value
        i = i + 1
    }
}

fn total(a: [i64]) -> i64 {
    let sum = 0
    let i = 0
    while i < len(a) {
        sum = sum + a[i]
        i = i + 1
    }
    return sum
}

fn first_positive(a: [i64]) -> i64 {
    let i = 0
    while i < len(a) {
        if a[i] > 0 {
            let pair: [i64] = [a[i], a[i] * 10]
            return pair[1]
        }
        i = i + 1
    }
    return 0
}

fn main() {
    let a: [i64] = [0, 0, 0]
    print(total(a))
    fill(a, 5)
    print(total(a))
    if len(a) > 0 {
        let inner: [i64] = [1, 2]
        print(total(inner))
    }
    print(total([10, 20]))
    print(first_positive(a))
    print(first_positive([0 - 1, 0 - 2]))
}
