edition 2;

struct Limit {
    max: i64
}

fn clamp(n: i64, limit: Limit) -> Result(i64, str) {
    if n > limit.max { return Result(i64, str)::Err("too big") }
    if n < 0 { return Result(i64, str)::Err("negative") }
    return Result(i64, str)::Ok(n)
}

fn total(a: i64, b: i64, limit: Limit) -> Result(i64, str) {
    let x = clamp(a, limit)?
    let y = clamp(b, limit)?
    let sum = x + y
    let checked = clamp(sum, limit)?
    return Result(i64, str)::Ok(checked)
}

fn report(result: Result(i64, str)) -> i64 {
    match result {
        Result(i64, str)::Ok(v) => { return v }
        Result(i64, str)::Err(e) => { return 0 - 1 }
    }
}

fn main() {
    let limit = Limit(max: 10)
    print(report(total(1, 2, limit)))
    print(report(total(8, 9, limit)))
    print(report(total(0 - 1, 2, limit)))
    print(report(total(1, 2, limit)))
}
