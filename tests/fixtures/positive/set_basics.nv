edition 2;

fn main() {
    let seen: HashSet(i64) = set_new()
    let i: i64 = 0
    while i < 10 {
        set_add(seen, i % 4)
        i = i + 1
    }
    print(set_len(seen))
    print(set_contains(seen, 3))
    let total: i64 = 0
    for x in seen { total = total + x }
    print(total)
    print(set_remove(seen, 2))
    print(set_remove(seen, 9))
    print(set_len(seen))
    set_clear(seen)
    print(set_len(seen))
}
