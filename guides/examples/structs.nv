edition 2;

struct Point {
    x: i64,
    y: i64
}

fn manhattan(p: Point) -> i64 {
    let ax = p.x
    if ax < 0 { ax = 0 - ax }
    let ay = p.y
    if ay < 0 { ay = 0 - ay }
    return ax + ay
}

fn main() {
    let a = Point(x: 3, y: 0 - 4)
    print(manhattan(a))
    a.x = 10
    print(a.x)
    let b = a
    b.y = 1
    print(a.y)
    print(b.y)
}
