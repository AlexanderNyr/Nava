fn fill(a: mut [i64], value: i64) {
    for i in 0..len(a) {
        a[i] = value * i
    }
}

fn total(a: [i64]) -> i64 {
    let sum = 0
    for item in a {
        sum = sum + item
    }
    return sum
}

fn main() {
    let a = array_zeros(5)
    fill(a, 3)
    print(len(a))
    print(total(a))
    a[1] = 100
    print(a[1])
    print(a[4])
}
