fn sort(a: mut [i64]) {
    let i = 1
    while i < len(a) {
        let key = a[i]
        let j = i - 1
        while j >= 0 && a[j] > key {
            a[j + 1] = a[j]
            j = j - 1
        }
        a[j + 1] = key
        i = i + 1
    }
}

fn main() {
    let n = read_i64()
    let values: [i64] = array_zeros(n)
    let i = 0
    while i < n {
        values[i] = read_i64()
        i = i + 1
    }
    sort(values)
    i = 0
    while i < n {
        print(values[i])
        i = i + 1
    }
}
