fn count_primes(limit: i64) -> i64 {
    if limit < 2 {
        return 0
    }
    let composite: [i64] = array_zeros(limit + 1)
    let count = 0
    let candidate = 2
    while candidate <= limit {
        if composite[candidate] == 0 {
            count = count + 1
            let multiple = candidate * candidate
            while multiple <= limit {
                composite[multiple] = 1
                multiple = multiple + candidate
            }
        }
        candidate = candidate + 1
    }
    return count
}

fn main() {
    print(count_primes(read_i64()))
}
